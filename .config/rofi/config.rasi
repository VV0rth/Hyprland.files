configuration {
    modes: "drun,run";
    show-icons: true;
    drun-display-format: "{name}";
    matching: "fuzzy";
}

* {
    font: "Cantarell 11";
    background-color: transparent;
    text-color: #ede0dc;
}

window {
    location: center;
    width: 36%;
    border: 1px;
    border-radius: 15px;
    border-color: #53433f;
    background-color: #181210;
    padding: 14px;
}

mainbox { spacing: 10px; }
inputbar {
    children: [ entry ];
    padding: 10px;
    border-radius: 9px;
    background-color: #251e1c;
}
entry {
    placeholder: "Search applications";
    placeholder-color: #d8c2bb;
}
listview {
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 3px;
}
element {
    padding: 7px;
    spacing: 8px;
    border-radius: 8px;
}
element selected {
    background-color: #ffb59d;
    text-color: #5d1900;
}
element-icon {
    size: 22px;
    vertical-align: 0.5;
}
element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
